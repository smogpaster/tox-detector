# Kopiere diese Datei nach .env. Die .env wird nicht eingecheckt.
PORT=8787

# STT-Anbieter: soniox (Standard) oder fake (Skript-Dialog, kein Key nötig)
STT_PROVIDER=soniox
SONIOX_API_KEY=
# EU-Endpunkt (Standard). US wäre wss://stt-rt.soniox.com/transcribe-websocket
SONIOX_WS_URL=wss://stt-rt.eu.soniox.com/transcribe-websocket
SONIOX_MODEL=stt-rt-v5

# Transkripte als JSON unter DATA_DIR/sessions speichern (true = Standard). Löschen per UI/API.
PERSIST_TRANSCRIPTS=true
DATA_DIR=./data

# NUR ENTWICKLUNG: erlaubt dem Client, für die Diarization-Bench Rohaudio als WAV
# unter DATA_DIR/debug mitzuschneiden. Im Normalbetrieb false lassen.
DEV_AUDIO_DUMP=false

# Ab Meilenstein 2 (Analyse)
ANTHROPIC_API_KEY=
