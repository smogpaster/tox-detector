# Kopiere diese Datei nach .env. Die .env wird nicht eingecheckt.
PORT=8787

# STT-Anbieter: soniox (Standard) oder fake (Skript-Dialog, kein Key nötig)
STT_PROVIDER=soniox
SONIOX_API_KEY=
# EU-Endpunkt (Standard). US wäre wss://stt-rt.soniox.com/transcribe-websocket
SONIOX_WS_URL=wss://stt-rt.eu.soniox.com/transcribe-websocket
SONIOX_MODEL=stt-rt-v5

# Transkripte als JSON unter DATA_DIR/sessions speichern (true = Standard). Löschen per UI/API.
PERSIST_TRANSCRIPTS=true
DATA_DIR=./data

# NUR ENTWICKLUNG: erlaubt dem Client, für die Diarization-Bench Rohaudio als WAV
# unter DATA_DIR/debug mitzuschneiden. Im Normalbetrieb false lassen.
DEV_AUDIO_DUMP=false

# Analyse mit der Claude API. Ohne Key läuft die App nur als Transkriptions-Prototyp.
ANTHROPIC_API_KEY=
ANALYSIS_ENABLED=true
# "mock" statt eines Modellnamens liefert eine Stichwort-Attrappe ohne API-Aufrufe (nur zum Testen)
ANALYSIS_MODEL=claude-opus-5
# Ein Analysefenster alle N Beiträge oder alle N Sekunden (wenn mindestens 3 neue Beiträge da sind)
ANALYSIS_WINDOW_UTTERANCES=8
ANALYSIS_WINDOW_SECONDS=60

# Neutrale Live-Hinweise auf der Brille ("Tempo steigt", "Pause?"), höchstens einer pro Intervall
HINTS_ENABLED=true
HINT_MIN_INTERVAL_SEC=90
